"""Build DTT-Enclosed.FCStd, its STEP, the printed parts' STEPs and the renders.

    xvfb-run -a freecad make_assembly.FCMacro
    DTT_CASE=slanted xvfb-run -a freecad make_assembly.FCMacro    (the slanted variant, into slanted/)

Geometry and dimensions live in build_enclosed_case.py (PARAMS). The parts'
meshes for make_3mf.py go to the system's temporary folder.
"""

import os
import sys

import FreeCAD as App
import FreeCADGui as Gui
import ImportGui
import MeshPart
import Part

HERE = os.path.dirname(os.path.abspath(globals().get("__file__") or next(
    a for a in sys.argv if a.endswith("make_assembly.FCMacro"))))
sys.path.insert(0, HERE)
import build_enclosed_case as B  # noqa: E402

V = App.Vector
BLACK = (0.16, 0.16, 0.17)
BLUE = (0.09, 0.42, 0.93)
CYAN = BLUE  # logo fill, printed in the same blue filament as the touch points
CUP = (0.80, 0.84, 0.88)
IMAGES = os.path.join(B.OUT, "images")
EXPLODE = {"housing": 45.0, "cover": -14.0, "screws": -28.0, "cups": -48.0, "slider": 14.0}


def paint(o, colour):
    o.ViewObject.ShapeAppearance = (App.Material(DiffuseColor=colour),)
    o.ViewObject.ShapeColor = colour
    o.ViewObject.Deviation = 0.02  # fine enough that the top round renders smooth
    o.ViewObject.AngularDeflection = 4.0


def feature(doc, name, label, shape, colour, group=None):
    o = doc.addObject("Part::Feature", name)
    o.Label = label
    o.Shape = shape
    paint(o, colour)
    if group is not None:
        group.addObject(o)
    return o


def exploded(doc, src, offset):
    e = doc.getObject("Exploded_" + src.Name)
    if e is None:
        e = doc.addObject("Part::Feature", "Exploded_" + src.Name)
        doc.getObject("ExplodedView").addObject(e)
    e.Label = "Exploded " + src.Label
    s = src.Shape.copy()
    s.translate(offset)
    e.Shape = s
    paint(e, src.ViewObject.ShapeColor)
    return e


def remove(doc, name):
    for n in (name, "Exploded_" + name):
        if doc.getObject(n):
            doc.removeObject(n)


def move_parts(doc):
    """The distance sensor moves to the centreline with its window; its
    exploded copies move too. The source model's two sensor mounting screws
    go: the posts' pins take the holes they sat in. The USB-C receptacle's
    model moves to where the KiCad board and the part's drawing put it, and
    the cell to the middle of its rings, 0.25 off its stop. The screen module
    gets its real thickness and the header's solder points, and moves to sit
    its face on the plate."""
    dz, oled = B.build_oled(doc)
    moves = [(V(B.P["sensor_shift"], 0, 0), ("SensorPCB", "SensorOpticalCase", "SensorLenses", "SensorConnector")),
             (V(*B.P["usb_model_shift"]), ("Part__Feature006", "USBCTongue", "USBCContacts")),
             (V(0, *B.P["battery_model_shift"]), ("BatteryPouch", "BatteryTape")),
             (V(0, 0, dz), B.OLED_PARTS)]
    for n in ("SensorScrew1", "SensorScrew2"):
        remove(doc, n)
    for n, shape in oled.items():
        for name in (n, "Exploded_" + n):
            o = doc.getObject(name)
            if o is not None:
                place = o.Placement  # the exploded copy's offset
                o.Shape = shape
                o.Placement = place
    for d, names in moves:
        for n in names:
            for name in (n, "Exploded_" + n):
                o = doc.getObject(name)
                if o is not None:
                    o.Placement = App.Placement(d, App.Rotation()).multiply(o.Placement)


def feature_tree(doc, features):
    """The housing's features in build order, in a hidden group, so each can
    be shown on its own: what it adds (blue) or removes (red)."""
    grp = doc.addObject("App::DocumentObjectGroup", "HousingFeatures")
    grp.Label = "Housing features - build order"
    sign = {"base": "", "add": " (+)", "cut": " (-)"}
    colour = {"base": BLACK, "add": BLUE, "cut": (0.86, 0.27, 0.22)}
    for i, (name, op, shape) in enumerate(features, 1):
        o = feature(doc, "HousingFeature%02d" % i, "%02d %s%s" % (i, name, sign[op]), shape, colour[op], grp)
        if op == "cut":
            o.ViewObject.Transparency = 40
        o.Visibility = False


def assemble():
    doc = App.openDocument(B.SOURCE)
    g = B.build_all(doc)
    for k in ("housing", "slider", "cover"):
        s = g[k]
        print(k, s.isValid(), len(s.Solids), round(s.Volume, 1))
    move_parts(doc)

    # The logo body is bound to the housing and would re-pad against the new
    # shape, so replace it with the moved inlay as a plain part.
    body = doc.getObject("Body")
    body.removeObjectsFromDocument()
    doc.removeObject("Body")
    logo = feature(doc, "LogoInlay", "R+D logo inlay - print blue", g["logo"], CYAN, doc.getObject("Part"))
    button = feature(doc, "ButtonInlay", "Button inlay - print blue", g["button"], BLUE, doc.getObject("Part"))

    housing = doc.getObject("Part__Feature001")
    housing.Shape = g["housing"]
    housing.Label = "Outer Body - enclosed"
    paint(housing, BLACK)
    s1 = doc.getObject("Part__Feature002")
    s1.Shape = g["s1"]

    remove(doc, "LoopVelcro")
    screws = []
    for i in range(1, 5):
        o = doc.getObject("PCBMountScrew%d" % i)
        o.Placement = App.Placement()
        o.Shape = g["screws"][i - 1]  # flat head, flush in the rear cover
        o.Label = "PCB screw %d - 0408LTFB Torx flat head self-tapping" % i
        screws.append(o)
    lb = doc.getObject("LoopBacking")
    lb.Label = "Rear cover"
    lb.Visibility = True
    fasteners = doc.getObject("Fasteners")
    cover = feature(doc, "RearCoverCups", "Rear cover, suction cups - print black", g["cup_cover"], BLACK, lb)
    cups = []
    for i, s in enumerate(g["cups"], 1):
        o = feature(doc, "SuctionCup%d" % i, "Suction cup %d - not printed" % i, s, CUP, lb)
        o.ViewObject.Transparency = 30
        cups.append(o)
    slider = feature(doc, "SwitchCover", "Switch cover - print blue", g["slider"], BLUE,
                     doc.getObject("Cover___V3_v5"))
    # The smooth rear cover goes in place of the suction-cup one, so it sits
    # in its own hidden group, out of the STEP and the usual renders.
    alt = doc.addObject("App::Part", "SmoothBack")
    alt.Label = "Smooth rear cover - swap for the rear cover"
    feature(doc, "RearCover", "Smooth rear cover - print black", g["cover"], BLACK, alt)
    alt.Visibility = False

    exploded(doc, housing, V(0, 0, EXPLODE["housing"]))
    exploded(doc, s1, V(0, 0, 0))
    exploded(doc, logo, V(0, 0, EXPLODE["housing"]))
    exploded(doc, button, V(0, 0, EXPLODE["housing"]))
    exploded(doc, cover, V(0, 0, EXPLODE["cover"]))
    exploded(doc, slider, V(EXPLODE["slider"], 0, EXPLODE["housing"]))
    for o in screws:
        exploded(doc, o, V(0, 0, EXPLODE["screws"]))
    for o, k in zip(cups, B.P["cup_keys"]):  # off their entry holes
        c, _, e = B.cup_key(k)
        exploded(doc, o, V(e.x - c.x, e.y - c.y, EXPLODE["cups"])).ViewObject.Transparency = 30

    feature_tree(doc, g["features"])
    doc.getObject("Cover___V3_v5").Label = "Housing - black shell, white diffuser, blue switch cover"
    fasteners.Label = "Fasteners - 4 PCB screws"
    for n in ("Cover___V3_v5", "Part", "LoopBacking", "Fasteners"):
        doc.getObject(n).Visibility = True
    p = doc.getObject("AssemblyParameters")
    x0, y0, x1, y1 = B.P["outer"]
    for label, v in [("RearCoverThickness", B.P["cover_thickness"]), ("CaseWidth", x1 - x0),
                     ("SwitchCoverTravel", B.P["travel"])]:
        if not hasattr(p, label):
            p.addProperty("App::PropertyLength", label, "Enclosed case")
        setattr(p, label, v)
    doc.recompute()
    os.makedirs(B.OUT, exist_ok=True)
    doc.saveAs(B.OUT_FCSTD)
    return doc


def step_objects(doc):
    skip = {"ExplodedView", "DiffuserConstruction", "AssemblyReferences"}
    roots = [doc.getObject("Cover___V3_v5")] + list(doc.RootObjects)  # the logo binder links the housing group
    return [o for o in roots if o.TypeId == "App::Part" and o.Name not in skip and o.Visibility]


def export(doc):
    ImportGui.export(step_objects(doc), B.OUT_STEP)
    os.makedirs(B.PARTS, exist_ok=True)
    os.makedirs(B.MESHES, exist_ok=True)
    parts = [
        ("Housing-Black", doc.getObject("Part__Feature001").Shape),
        ("Housing-Diffuser-White", doc.getObject("IntegratedDiffuser").Shape),
        ("Housing-Inlays-Blue", Part.makeCompound([doc.getObject("LogoInlay").Shape,
                                                   doc.getObject("ButtonInlay").Shape])),
        ("Switch-Cover-Blue", doc.getObject("SwitchCover").Shape),
        ("Rear-Cover-Cups-Black", doc.getObject("RearCoverCups").Shape),
        ("Rear-Cover-Smooth-Black", doc.getObject("RearCover").Shape),
    ]
    for name, s in parts:
        s.exportStep(os.path.join(B.PARTS, name + ".step"))
        m = MeshPart.meshFromShape(Shape=s, LinearDeflection=0.02, AngularDeflection=0.2)
        m.write(os.path.join(B.MESHES, name + ".stl"))


def camera(view, d, up=(0, 0, 1)):
    from pivy import coin
    d = V(*d)
    d.normalize()
    z = -d
    u = V(*up)
    x = u.cross(z)
    if x.Length < 1e-6:
        x = V(1, 0, 0)
    x.normalize()
    y = z.cross(x)
    m = App.Matrix(x.x, y.x, z.x, 0, x.y, y.y, z.y, 0, x.z, y.z, z.z, 0, 0, 0, 0, 1)
    q = App.Rotation(m).Q
    view.getCameraNode().orientation.setValue(coin.SbRotation(q[0], q[1], q[2], q[3]))
    view.fitAll()


def show_only(doc, names):
    keep = set(names)
    for o in doc.Objects:
        if o.TypeId.startswith("Part::") or o.TypeId in ("App::Link", "PartDesign::Body"):
            o.Visibility = o.Name in keep


def render(doc):
    os.makedirs(IMAGES, exist_ok=True)
    saved = {o.Name: o.Visibility for o in doc.Objects if hasattr(o, "Visibility")}
    gd = Gui.getDocument(doc.Name)
    view = gd.activeView()
    view.setCameraType("Orthographic")
    Gui.runCommand("Std_DrawStyle", 0)
    shapes = [o.Name for o in doc.Objects if o.TypeId.startswith("Part::") or o.TypeId in ("App::Link", "PartDesign::Body")]
    assembled = []
    for grp in step_objects(doc):
        for o in grp.OutListRecursive:
            if o.Name in shapes:
                assembled.append(o.Name)
    always = ("Part__Feature001", "Diffuser", "LogoInlay", "ButtonInlay", "RearCoverCups", "SwitchCover")
    assembled = [n for n in assembled if saved.get(n) or n in always]
    cups = ["SuctionCup1", "SuctionCup2"]
    # Assembled: from the front, and from the wall side with the cups clicked in.
    show_only(doc, [n for n in assembled if n not in cups])
    camera(view, (-1, 1.3, -0.9))
    view.saveImage(os.path.join(IMAGES, "Enclosed-Front.png"), 1400, 1100, "White")
    show_only(doc, assembled)
    camera(view, (-1, 1.2, 1.0))
    view.saveImage(os.path.join(IMAGES, "Enclosed-Rear.png"), 1400, 1100, "White")
    if not B.SLANTED:  # the same view with the smooth rear cover and its loft
        doc.getObject("SmoothBack").Visibility = True
        show_only(doc, [n for n in assembled if n not in cups + ["RearCoverCups"]] + ["RearCover"])
        camera(view, (-1, 1.2, 1.0))
        view.saveImage(os.path.join(IMAGES, "Enclosed-Rear-Smooth.png"), 1400, 1100, "White")
        doc.getObject("SmoothBack").Visibility = False
    # Exploded view.
    ex = [o.Name for o in doc.getObject("ExplodedView").Group if o.Name.startswith("Exploded_")]
    show_only(doc, ex)
    doc.getObject("ExplodedView").Visibility = True
    camera(view, (-1, 1.4, -0.8))
    view.saveImage(os.path.join(IMAGES, "Enclosed-Exploded.png"), 1400, 1400, "White")
    doc.getObject("ExplodedView").Visibility = False
    for n, vis in saved.items():
        doc.getObject(n).Visibility = vis


def main():
    doc = assemble()
    export(doc)
    if App.GuiUp:
        render(doc)
    doc.save()
    os._exit(0)


main()
