static constexpr int HTTPC_ERROR_CONNECTION_REFUSED = -1;
static constexpr int HTTPC_ERROR_TOO_LESS_RAM = -8;
static constexpr int HTTPC_ERROR_READ_TIMEOUT = -11;
static constexpr int HTTPC_DISABLE_FOLLOW_REDIRECTS = 0;
struct Response {
    int status = 200, declaredSize = -1;
    String body = "{\"ok\":true}", encoding;
    bool trusted = true, stall = false;
    unsigned delayPerChunk = 0;
} response;
static unsigned posts = 0;
static std::map<std::string, std::string> headers;
// Dashboard requests share the firmware's single TLS request slot.
static unsigned requestLocksHeld = 0;
class NetworkRequestLock {
 public:
    NetworkRequestLock() { ++requestLocksHeld; }
    ~NetworkRequestLock() { --requestLocksHeld; }
};
class HTTPClient {
    WiFiClient *client = nullptr;
    String url;
 public:
    void setTimeout(int n) { assert(n > 0 && n <= 30000); }
    void setConnectTimeout(int n) { assert(n > 0 && n <= 30000); }
    void setReuse(bool reuse) { assert(!reuse); }
    void setFollowRedirects(int mode) { assert(mode == 0); }
    bool begin(WiFiClient &value, const String &target) { client = &value; url = target; return true; }
    void collectHeaders(const char **, int) {}
    void addHeader(const String &key, const String &value) { headers[key] = value; }
    int POST(const String &) {
        assert(requestLocksHeld == 1);
        if (url.startsWith("https://") && (!client->ca || !response.trusted)) return -1;
        if (!client->connect("dashboard.invalid", 443, 1000)) return -1;
        ++posts;
        client->incoming = response.body;
        return response.status;
    }
    String header(const char *) { return response.encoding; }
    int getSize() { return response.declaredSize; }
    int writeToStream(Stream *sink) {
        int received = 0;
        while (client->connected()) {
            if (response.stall) { delay(1); continue; }
            if (client->available() == 0) break;
            uint8_t bytes[1024];
            const int count = client->read(bytes, sizeof(bytes));
            if (count <= 0) return -2;
            if (sink->write(bytes, count) != static_cast<size_t>(count)) return -8;
            received += count;
            delay(response.delayPerChunk);
        }
        if (response.declaredSize >= 0 && received != response.declaredSize) return -2;
        return received;
    }
    void end() { if (client) client->stop(); }
    static String errorToString(int) { return "synthetic transport failure"; }
};
namespace { extern const uint8_t dashboardCaBundle[] asm("_binary_x509_crt_bundle_start") = {1}; }
// ACTUAL_TRANSPORT

// A minimal storage port with short-write, rename-failure and power-cut states.
static std::map<std::string, std::shared_ptr<std::string>> files;
static size_t writeLimit = SIZE_MAX;
static std::string renameFailure;
static bool mountFails = false;
class File {
    std::shared_ptr<std::string> data;
    size_t position = 0;
 public:
    File() = default;
    explicit File(std::shared_ptr<std::string> value) : data(value) {}
    explicit operator bool() const { return data != nullptr; }
    size_t size() const { return data ? data->size() : 0; }
    void close() {}
    void flush() {}
    size_t write(uint8_t value) { return write(&value, 1); }
    size_t write(const uint8_t *buffer, size_t size) {
        if (!data || data->size() >= writeLimit) return 0;
        const size_t count = std::min(size, writeLimit - data->size());
        data->append(reinterpret_cast<const char *>(buffer), count); return count;
    }
    int read() { return data && position < data->size() ? static_cast<uint8_t>((*data)[position++]) : -1; }
    size_t readBytes(char *buffer, size_t size) {
        size_t count = 0;
        for (int ch; count < size && (ch = read()) >= 0;) buffer[count++] = ch;
        return count;
    }
};
struct {
    bool begin(bool format) { assert(!format); return !mountFails; }
    bool exists(const char *path) { return files.count(path); }
    bool remove(const char *path) { return files.erase(path); }
    File open(const char *path, const char *mode) {
        if (mode[0] == 'w') files[path] = std::make_shared<std::string>();
        return exists(path) ? File(files[path]) : File();
    }
    bool rename(const char *from, const char *to) {
        if (renameFailure == from || !exists(from) || exists(to)) return false;
        files[to] = files[from]; files.erase(from); return true;
    }
} SPIFFS;
#define SESSION_FILE "/session.json"
// ACTUAL_CACHE
class WiFiManager { public: static String htmlEntities(String, bool = false); };
// ACTUAL_HTML

static JsonDocument sessionDocument(const char *name) {
    JsonDocument doc;
    const char *fixture = R"({"name":"test","segmentCount":1,"pageIdx":0,"segments":[{"idx":0,"type":"repetition","params":{"target":10,"startPosition":10,"endPosition":1,"trainingDepthIncrease":0,"trainingSpeed":10,"targetWindow":1}}]})";
    assert(!deserializeJson(doc, fixture));
    doc["name"] = name;
    return doc;
}
int main() {
    JsonDocument doc; doc["id"] = "synthetic";
    String body = "stale";
    assert(postJson("/get-settings", doc, &body, 1000) == 200);
    assert(body == response.body && headers["Accept-Encoding"] == "identity");
    response.trusted = false;
    assert(postJson("/get-settings", doc, &body, 1000) < 0 && body.empty());
    response = Response{};
    const auto beforeInvalidCertificate = posts;
    peerCertificate.valid_to.year = 2021;
    assert(postJson("/get-settings", doc, &body, 1000) < 0 && posts == beforeInvalidCertificate);
    peerCertificate.valid_to.year = 2035;
    mbedtls_x509_crt intermediate = {
        {2020, 1, 1, 0, 0, 0}, {2021, 1, 1, 0, 0, 0}, nullptr};
    peerCertificate.next = &intermediate;
    assert(postJson("/get-settings", doc, &body, 1000) < 0 && posts == beforeInvalidCertificate);
    peerCertificate.next = nullptr;
    peerCertificateResult = nullptr;
    assert(postJson("/get-settings", doc, &body, 1000) < 0 && posts == beforeInvalidCertificate);
    peerCertificateResult = &peerCertificate;
    utc = 0; synchronize = false;
    const auto before = posts;
    assert(postJson("/get-settings", doc, &body, 1000) < 0 && posts == before);
    synchronize = true;
    assert(postJson("https://other.invalid/api/dtt/v2/x", doc, &body, 1000) < 0);
    assert(postJson("https://dashboard.invalid.evil/api/dtt/v2/x", doc, &body, 1000) < 0);
    assert(postJson("//other.invalid/x", doc, &body, 1000) < 0);
    configuredOrigin = "http://localhost:8000";
#ifdef DTT_ALLOW_LOCAL_HTTP
    assert(postJson("/is-paired", doc, &body, 1000) == 200);
    assert(postJson("http://localhost:8001/api/dtt/v2/x", doc, &body, 1000) < 0);
#else
    assert(postJson("/is-paired", doc, &body, 1000) < 0);
#endif
    configuredOrigin = "https://dashboard.invalid";
    response.body = std::string(MAX_DASHBOARD_RESPONSE_BYTES, 'a');
    response.declaredSize = response.body.size();
    assert(postJson("/x", doc, &body, 1000) == 200 && body.size() == MAX_DASHBOARD_RESPONSE_BYTES);
    response.body += 'a'; response.declaredSize = response.body.size();
    assert(postJson("/x", doc, &body, 1000) < 0 && body.empty());
    response.declaredSize = -1;
    assert(postJson("/x", doc, &body, 1000) < 0 && body.empty());
    assert(postJson("/x", doc, nullptr, 1000) < 0);
    response = Response{}; response.stall = true;
    auto start = clockMs;
    assert(postJson("/x", doc, &body, 1000) == HTTPC_ERROR_READ_TIMEOUT);
    assert(body.empty() && clockMs - start == 1000);
    response.stall = false; response.body = std::string(4000, 'b'); response.delayPerChunk = 400;
    assert(postJson("/x", doc, &body, 1000) == HTTPC_ERROR_READ_TIMEOUT && body.empty());
    response = Response{}; response.encoding = "gzip";
    assert(postJson("/x", doc, &body, 1000) < 0 && body.empty());
    response = Response{}; response.status = 418;
    assert(postJson("/x", doc, &body, 1000) == 418);
    response = Response{}; response.body = ""; response.declaredSize = 0;
    assert(postJson("/x", doc, &body, 1000) == 200 && body.empty());
    allocationFails = true;
    assert(postJson("/x", doc, &body, 1000) < 0 && body.empty());
    allocationFails = false;
    ESP.heap = 100;
    assert(postJson("/x", doc, &body, 1000) < 0 && body.empty()); ESP.heap = 200000;
    // Header and chunk-framing bytes consume the same wire budget; no double count.
    DashboardClient<WiFiClientSecure> wire(1000);
    wire.incoming = std::string(MAX_DASHBOARD_WIRE_BYTES + 1, 'x');
    for (size_t i = 0; i < MAX_DASHBOARD_WIRE_BYTES; ++i) assert(wire.read() == 'x');
    assert(wire.read() == -1 && wire.failed() && wire.streamTimeout == 0);
    clockMs = UINT32_MAX - 20;
    DashboardClient<WiFiClient> rollover(100);
    delay(99); assert(rollover.connected());
    delay(1); assert(!rollover.connected());

    String error;
    auto oldDoc = sessionDocument("old");
    auto newDoc = sessionDocument("new");
    assert(persistSessionDocument(oldDoc, error));
    const auto oldBytes = *files[SESSION_FILE];
    writeLimit = 10;
    assert(!persistSessionDocument(newDoc, error));
    assert(*files[SESSION_FILE] == oldBytes);
    writeLimit = SIZE_MAX;
    renameFailure = SESSION_TEMP_FILE;
    assert(!persistSessionDocument(newDoc, error));
    assert(*files[SESSION_FILE] == oldBytes);
    renameFailure.clear();
    assert(persistSessionDocument(newDoc, error));
    assert(!files.count(SESSION_BACKUP_FILE));
    JsonDocument recovered;
    assert(readSessionCache(SESSION_FILE, recovered, error));
    assert(recovered["name"] == "new");
    // Simulate loss after primary -> backup, before temporary -> primary.
    files[SESSION_BACKUP_FILE] = files[SESSION_FILE]; files.erase(SESSION_FILE);
    assert(!readSessionCache(SESSION_FILE, recovered, error));
    assert(readSessionCache(SESSION_BACKUP_FILE, recovered, error));
    files[SESSION_FILE] = std::make_shared<std::string>("{bad");
    assert(!readSessionCache(SESSION_FILE, recovered, error));
    renameFailure = SESSION_TEMP_FILE;
    assert(!persistSessionDocument(oldDoc, error));
    assert(readSessionCache(SESSION_FILE, recovered, error));
    assert(recovered["name"] == "new");
    renameFailure.clear();
    files[SESSION_FILE] = std::make_shared<std::string>("{}");
    assert(!readSessionCache(SESSION_FILE, recovered, error));
    files[SESSION_FILE] = std::make_shared<std::string>(MAX_DASHBOARD_RESPONSE_BYTES + 1, ' ');
    assert(!readSessionCache(SESSION_FILE, recovered, error));
    mountFails = true;
    assert(!persistSessionDocument(oldDoc, error));
    mountFails = false;

    const String ssid = "a'\"><img src=x onerror=alert(1)>&";
    const String escaped = WiFiManager::htmlEntities(ssid);
    assert(escaped == "a&#39;&quot;&gt;&lt;img src=x onerror=alert(1)&gt;&amp;");
    assert(ssid == "a'\"><img src=x onerror=alert(1)>&");
    assert(WiFiManager::htmlEntities("ordinary network") == "ordinary network");
    assert(WiFiManager::htmlEntities("&lt;") == "&amp;lt;");
    assert(WiFiManager::htmlEntities(" a ", true) == "&#160;a&#160;");
    std::cout << "all assertions passed\n";
}
