static JsonDocument sessionDocument(const char *name) {
    JsonDocument doc;
    const char *fixture = R"({"name":"test","segmentCount":1,"pageIdx":0,"segments":[{"idx":0,"type":"repetition","params":{"target":10,"startPosition":10,"endPosition":1,"trainingDepthIncrease":0,"trainingSpeed":10,"targetWindow":1}}]})";
    assert(!deserializeJson(doc, fixture));
    doc["name"] = name;
    return doc;
}

static void resetFetch() {
    files.clear(); writeLimit = SIZE_MAX; renameFailure.clear(); removeFailure.clear(); mountFails = false;
    response = Response{}; session = Session{}; machine = StateMachine{};
    wifiStatus = WL_CONNECTED; liveInstalls = flushCalls = loadFailures = 0;
    clockMs = 1000; ESP.heap = 200000;
#ifdef DTT_ALLOW_LOCAL_HTTP
    configuredOrigin = "http://127.0.0.1:3000";
#else
    configuredOrigin = "https://dashboard.invalid";
#endif
    auto document = sessionDocument("sentinel-private-name");
    document["id"] = "sentinel-private-identifier";
    document["description"] = "sentinel-private-body";
    response.body.clear(); serializeJson(document, response.body);
}

static void testFetchDiagnostics() {
    resetFetch();
    fetchSettingsTask(nullptr);
    auto status = getSettingsFetchStatus();
    assert(status.stage == SettingsFetchStage::Installed);
    assert(status.httpStatus == 200 && status.clientStatus == 200);
    assert(status.attempt == 1 && status.responseBytes == response.body.size());
    assert(status.retainedBodyBytes == response.body.size() && status.parseCode == 0);
    assert(status.callbackInvoked && status.eventAccepted && status.persisted && status.installed);
    assert(liveInstalls == 1 && flushCalls == 1 && files.count(SESSION_FILE));

    // A server200 and a completely read prefix can still be a failed body read.
    resetFetch(); response.declaredSize = response.body.size() + 1;
    fetchSettingsTask(nullptr); status = getSettingsFetchStatus();
    assert(status.stage == SettingsFetchStage::HttpFailed);
    assert(status.httpStatus == 200 && status.clientStatus < 0 && status.attempt == 3);
    assert(status.responseBytes == response.body.size() && status.retainedBodyBytes == 0);
    assert(status.error == SettingsFetchError::Transport && !status.callbackInvoked);
    loadSessionTask(nullptr); status = getSettingsFetchStatus();
    assert(status.stage == SettingsFetchStage::HttpFailed);
    assert(status.cacheSource == SettingsCacheSource::Recovery && status.cacheMounted);

    resetFetch(); wifiStatus = 0;
    fetchSettingsTask(nullptr); status = getSettingsFetchStatus();
    assert(status.error == SettingsFetchError::Offline && status.attempt == 0);
    resetFetch(); response.status = 503;
    fetchSettingsTask(nullptr); status = getSettingsFetchStatus();
    assert(status.error == SettingsFetchError::Http && status.httpStatus == 503);

    resetFetch(); response.body = "{";
    fetchSettingsTask(nullptr); status = getSettingsFetchStatus();
    assert(status.stage == SettingsFetchStage::ParseFailed && status.parseCode != 0);
    assert(status.responseBytes == 1 && !status.callbackInvoked);
    resetFetch(); response.body = "{\"nested\":[[[[[[[[[[]]]]]]]]]]}";
    fetchSettingsTask(nullptr); status = getSettingsFetchStatus();
    assert(status.stage == SettingsFetchStage::ParseFailed && status.parseCode == DeserializationError::TooDeep);
    resetFetch(); response.body = "{\"name\":42,\"segments\":[]}";
    fetchSettingsTask(nullptr); status = getSettingsFetchStatus();
    assert(status.stage == SettingsFetchStage::ValidationFailed && status.parseCode == 0);

    resetFetch();
    auto page = sessionDocument("next page");
    page["segmentCount"] = 101; page["pageIdx"] = 1; page["segments"][0]["idx"] = 100;
    response.body.clear(); serializeJson(page, response.body);
    fetchSettingsTask(nullptr); status = getSettingsFetchStatus();
    assert(status.error == SettingsFetchError::RequestPage && !status.callbackInvoked);
    resetFetch(); machine.changeLivePage = true;
    fetchSettingsTask(nullptr); status = getSettingsFetchStatus();
    assert(status.error == SettingsFetchError::LivePage && status.callbackInvoked && !status.persisted);

    resetFetch(); mountFails = true;
    fetchSettingsTask(nullptr); status = getSettingsFetchStatus();
    assert(status.stage == SettingsFetchStage::PersistenceFailed);
    assert(status.persistenceError == SessionPersistenceError::Mount && !status.installed);
    loadSessionTask(nullptr); status = getSettingsFetchStatus();
    assert(status.persistenceError == SessionPersistenceError::Mount && !status.cacheMounted);
    resetFetch(); writeLimit = 10;
    fetchSettingsTask(nullptr); status = getSettingsFetchStatus();
    assert(status.persistenceError == SessionPersistenceError::Write && !status.persisted);
    resetFetch(); renameFailure = SESSION_TEMP_FILE;
    fetchSettingsTask(nullptr); status = getSettingsFetchStatus();
    assert(status.persistenceError == SessionPersistenceError::Commit && !status.installed);
    resetFetch(); machine.accepts = false;
    fetchSettingsTask(nullptr); status = getSettingsFetchStatus();
    assert(status.stage == SettingsFetchStage::StateRejected && !status.callbackInvoked && !status.eventAccepted);

    resetFetch();
    String error;
    auto cached = sessionDocument("cached");
    assert(persistSessionDocument(cached, error));
    wifiStatus = 0; fetchSettingsTask(nullptr); loadSessionTask(nullptr);
    status = getSettingsFetchStatus();
    assert(status.error == SettingsFetchError::Offline && status.cacheSource == SettingsCacheSource::Primary);
    files[SESSION_BACKUP_FILE] = files[SESSION_FILE]; files.erase(SESSION_FILE);
    loadSessionTask(nullptr); status = getSettingsFetchStatus();
    assert(status.error == SettingsFetchError::Offline && status.cacheSource == SettingsCacheSource::Backup);

    // New requests reset diagnostics; delayed older workers cannot overwrite it.
    const auto previous = status.generation;
    const auto next = beginSettingsFetchStatus();
    assert(next != previous);
    updateSettingsFetchStatus(previous, [](auto &value) { value.httpStatus = 999; });
    status = getSettingsFetchStatus();
    assert(status.httpStatus == 0 && status.parseCode == 255 && !status.installed);
    JsonDocument diagnostic;
    writeSettingsFetchStatus(diagnostic.to<JsonObject>(), status);
    std::string encoded; serializeJson(diagnostic, encoded);
    assert(encoded.find("sentinel") == std::string::npos);
    assert(encoded.find("synthetic-device") == std::string::npos);
    assert(!diagnostic["url"].is<const char *>() && !diagnostic["id"].is<const char *>());
    assert(diagnostic.size() == 10 && diagnostic["stage"] == "requesting");

    // Coherent fixed-size snapshots while a worker publishes a new phase.
    std::thread writer([next]() {
        for (size_t count = 0; count < 10000; ++count)
            updateSettingsFetchStatus(next, [count](auto &value) {
                value.responseBytes = count; value.retainedBodyBytes = count;
            });
    });
    for (size_t count = 0; count < 10000; ++count) {
        const auto coherent = getSettingsFetchStatus();
        assert(coherent.responseBytes == coherent.retainedBodyBytes);
    }
    writer.join();

    // Distinct persistence reasons retain existing cache/rollback semantics.
    resetFetch(); auto old = sessionDocument("old");
    assert(persistSessionDocument(old, error));
    const auto original = *files[SESSION_FILE];
    SessionPersistenceError failure;
    renameFailure = SESSION_FILE;
    assert(!persistSessionDocument(old, error, &failure));
    assert(failure == SessionPersistenceError::Stage && *files[SESSION_FILE] == original);
    renameFailure.clear(); files[SESSION_BACKUP_FILE] = std::make_shared<std::string>(original);
    removeFailure = SESSION_BACKUP_FILE;
    assert(!persistSessionDocument(old, error, &failure));
    assert(failure == SessionPersistenceError::Rotate && *files[SESSION_FILE] == original);
    removeFailure.clear();
    files[SESSION_FILE] = std::make_shared<std::string>("{bad");
    files[SESSION_BACKUP_FILE] = std::make_shared<std::string>("{bad");
    assert(!persistSessionDocument(old, error, &failure));
    assert(failure == SessionPersistenceError::Recover);
    old["description"] = std::string(MAX_DASHBOARD_RESPONSE_BYTES, 'x');
    assert(!persistSessionDocument(old, error, &failure));
    assert(failure == SessionPersistenceError::Limit);
}

// These names come from the actual DTT state table, not a guessed short name.
// DTT_STATE_NAMES
static void testDiagnosticReplyBudget() {
    SettingsFetchStatus worst;
    worst.generation = UINT32_MAX;
    worst.stage = SettingsFetchStage::PersistenceFailed;
    worst.error = SettingsFetchError::RequestPage;
    worst.persistenceError = SessionPersistenceError::Recover;
    worst.cacheSource = SettingsCacheSource::NotLoaded;
    worst.attempt = UINT8_MAX;
    worst.httpStatus = INT32_MAX;
    worst.clientStatus = INT32_MIN;
    worst.responseBytes = worst.retainedBodyBytes = UINT32_MAX;
    worst.parseCode = UINT8_MAX;
    worst.startedAtMs = worst.updatedAtMs = UINT32_MAX;
    worst.freeHeap = worst.largestBlock = UINT32_MAX;
    settingsFetchStatus = worst;
    radble::Server server;
    size_t maximumReply = 0;
    unsigned combinations = 0;
    for (const char *view : {"summary", "transport", "parse", "storage", "memory"}) {
        JsonDocument args; args["view"] = view;
        const auto result = settingsFetchDiagnostic(args.as<JsonObjectConst>());
        assert(result.ok);
        JsonDocument body;
        assert(!deserializeJson(body, result.resultJson));
        assert(body["v"] == 2 && body["view"] == view);
        assert(body["path"] == "connectivity.settings");
        assert(result.resultJson.find("sentinel") == std::string::npos);
        for (const char *before : dttStates) {
            for (const char *after : dttStates) {
                // Actual pinned Result and Server::sendStage implementations,
                // including the envelope, state names and 509-byte safety gate.
                server.sendStage(1, UINT32_MAX, "completed", result.ok,
                                 result.code.c_str(), result.message.c_str(),
                                 result.resultJson, before, after);
                assert(server.sent.size() <= radble::MAX_MESSAGE_BYTES);
                JsonDocument reply;
                assert(!deserializeJson(reply, server.sent));
                assert(reply["ok"] == true && reply["code"] == "ok");
                assert(reply["result"]["view"] == view);
                maximumReply = std::max(maximumReply, server.sent.size());
                ++combinations;
            }
        }
    }
    JsonDocument emptyArgs;
    auto result = settingsFetchDiagnostic(emptyArgs.as<JsonObjectConst>());
    JsonDocument defaultBody;
    assert(result.ok && !deserializeJson(defaultBody, result.resultJson));
    assert(defaultBody["view"] == "summary");
    for (const char *invalid : {"all", "sentinel-private-name", ""}) {
        JsonDocument args; args["view"] = invalid;
        result = settingsFetchDiagnostic(args.as<JsonObjectConst>());
        assert(!result.ok && result.code == "invalid_value");
        assert(result.message.find("sentinel") == std::string::npos);
    }
    JsonDocument invalidArgs; invalidArgs["view"] = 5;
    assert(!settingsFetchDiagnostic(invalidArgs.as<JsonObjectConst>()).ok);
    invalidArgs["view"] = std::string("summary\0private", 15);
    assert(!settingsFetchDiagnostic(invalidArgs.as<JsonObjectConst>()).ok);

    // Reproduce ab151eb's actual oversized shape through the same real gate.
    const String legacy = R"({"path":"connectivity.settings","v":1,"generation":0,"stage":"idle","error":"none","persistenceError":"none","cacheSource":"not_loaded","attempt":0,"httpStatus":0,"clientStatus":0,"responseBytes":0,"retainedBodyBytes":0,"parseCode":255,"overflow":false,"callbackInvoked":false,"eventAccepted":false,"persisted":false,"installed":false,"cacheMounted":false,"startedAtMs":0,"updatedAtMs":0,"freeHeap":0,"largestBlock":0})";
    server.sendStage(1, UINT32_MAX, "completed", true, "", "", legacy,
                     "play.calibration.min", "play.calibration.min");
    JsonDocument rejected;
    assert(!deserializeJson(rejected, server.sent));
    assert(rejected["ok"] == false && rejected["code"] == "response_too_large");
    std::cout << "actual reply budget: " << combinations
              << " combinations, max=" << maximumReply
              << "/" << radble::MAX_MESSAGE_BYTES << " bytes\n";
}
int main() {
    JsonDocument doc; doc["id"] = "synthetic";
    String body = "stale";
    assert(postJson("/get-settings", doc, &body, 1000) == 200);
    assert(body == response.body && headers["Accept-Encoding"] == "identity");
    response.trusted = false;
    assert(postJson("/get-settings", doc, &body, 1000) < 0 && body.empty());
    response = Response{};
    const auto beforeInvalidCertificate = posts;
    peerCertificate.valid_to.year = 2021;
    assert(postJson("/get-settings", doc, &body, 1000) < 0 && posts == beforeInvalidCertificate);
    peerCertificate.valid_to.year = 2035;
    mbedtls_x509_crt intermediate = {
        {2020, 1, 1, 0, 0, 0}, {2021, 1, 1, 0, 0, 0}, nullptr};
    peerCertificate.next = &intermediate;
    assert(postJson("/get-settings", doc, &body, 1000) < 0 && posts == beforeInvalidCertificate);
    peerCertificate.next = nullptr;
    peerCertificateResult = nullptr;
    assert(postJson("/get-settings", doc, &body, 1000) < 0 && posts == beforeInvalidCertificate);
    peerCertificateResult = &peerCertificate;
    utc = 0; synchronize = false;
    const auto before = posts;
    assert(postJson("/get-settings", doc, &body, 1000) < 0 && posts == before);
    synchronize = true;
    assert(postJson("https://other.invalid/api/dtt/v2/x", doc, &body, 1000) < 0);
    assert(postJson("https://dashboard.invalid.evil/api/dtt/v2/x", doc, &body, 1000) < 0);
    assert(postJson("//other.invalid/x", doc, &body, 1000) < 0);
    configuredOrigin = "http://localhost:8000";
#ifdef DTT_ALLOW_LOCAL_HTTP
    assert(postJson("/is-paired", doc, &body, 1000) == 200);
    assert(postJson("http://localhost:8001/api/dtt/v2/x", doc, &body, 1000) < 0);
#else
    assert(postJson("/is-paired", doc, &body, 1000) < 0);
#endif
    configuredOrigin = "https://dashboard.invalid";
    response.body = std::string(MAX_DASHBOARD_RESPONSE_BYTES, 'a');
    response.declaredSize = response.body.size();
    assert(postJson("/x", doc, &body, 1000) == 200 && body.size() == MAX_DASHBOARD_RESPONSE_BYTES);
    response.body += 'a'; response.declaredSize = response.body.size();
    assert(postJson("/x", doc, &body, 1000) < 0 && body.empty());
    response.declaredSize = -1;
    assert(postJson("/x", doc, &body, 1000) < 0 && body.empty());
    assert(postJson("/x", doc, nullptr, 1000) < 0);
    response = Response{}; response.stall = true;
    auto start = clockMs;
    assert(postJson("/x", doc, &body, 1000) == HTTPC_ERROR_READ_TIMEOUT);
    assert(body.empty() && clockMs - start == 1000);
    response.stall = false; response.body = std::string(4000, 'b'); response.delayPerChunk = 400;
    assert(postJson("/x", doc, &body, 1000) == HTTPC_ERROR_READ_TIMEOUT && body.empty());
    response = Response{}; response.encoding = "gzip";
    assert(postJson("/x", doc, &body, 1000) < 0 && body.empty());
    response = Response{}; response.status = 418;
    assert(postJson("/x", doc, &body, 1000) == 418);
    response = Response{}; response.body = ""; response.declaredSize = 0;
    assert(postJson("/x", doc, &body, 1000) == 200 && body.empty());
    allocationFails = true;
    assert(postJson("/x", doc, &body, 1000) < 0 && body.empty());
    allocationFails = false;
    ESP.heap = 100;
    assert(postJson("/x", doc, &body, 1000) < 0 && body.empty()); ESP.heap = 200000;
    // Header and chunk-framing bytes consume the same wire budget; no double count.
    DashboardClient<WiFiClientSecure> wire(1000);
    wire.incoming = std::string(MAX_DASHBOARD_WIRE_BYTES + 1, 'x');
    for (size_t i = 0; i < MAX_DASHBOARD_WIRE_BYTES; ++i) assert(wire.read() == 'x');
    assert(wire.read() == -1 && wire.failed() && wire.streamTimeout == 0);
    clockMs = UINT32_MAX - 20;
    DashboardClient<WiFiClient> rollover(100);
    delay(99); assert(rollover.connected());
    delay(1); assert(!rollover.connected());

    String error;
    auto oldDoc = sessionDocument("old");
    auto newDoc = sessionDocument("new");
    assert(persistSessionDocument(oldDoc, error));
    const auto oldBytes = *files[SESSION_FILE];
    writeLimit = 10;
    assert(!persistSessionDocument(newDoc, error));
    assert(*files[SESSION_FILE] == oldBytes);
    writeLimit = SIZE_MAX;
    renameFailure = SESSION_TEMP_FILE;
    assert(!persistSessionDocument(newDoc, error));
    assert(*files[SESSION_FILE] == oldBytes);
    renameFailure.clear();
    assert(persistSessionDocument(newDoc, error));
    assert(!files.count(SESSION_BACKUP_FILE));
    JsonDocument recovered;
    assert(readSessionCache(SESSION_FILE, recovered, error));
    assert(recovered["name"] == "new");
    // Simulate loss after primary -> backup, before temporary -> primary.
    files[SESSION_BACKUP_FILE] = files[SESSION_FILE]; files.erase(SESSION_FILE);
    assert(!readSessionCache(SESSION_FILE, recovered, error));
    assert(readSessionCache(SESSION_BACKUP_FILE, recovered, error));
    files[SESSION_FILE] = std::make_shared<std::string>("{bad");
    assert(!readSessionCache(SESSION_FILE, recovered, error));
    renameFailure = SESSION_TEMP_FILE;
    assert(!persistSessionDocument(oldDoc, error));
    assert(readSessionCache(SESSION_FILE, recovered, error));
    assert(recovered["name"] == "new");
    renameFailure.clear();
    files[SESSION_FILE] = std::make_shared<std::string>("{}");
    assert(!readSessionCache(SESSION_FILE, recovered, error));
    files[SESSION_FILE] = std::make_shared<std::string>(MAX_DASHBOARD_RESPONSE_BYTES + 1, ' ');
    assert(!readSessionCache(SESSION_FILE, recovered, error));
    mountFails = true;
    assert(!persistSessionDocument(oldDoc, error));
    mountFails = false;

    const String ssid = "a'\"><img src=x onerror=alert(1)>&";
    const String escaped = WiFiManager::htmlEntities(ssid);
    assert(escaped == "a&#39;&quot;&gt;&lt;img src=x onerror=alert(1)&gt;&amp;");
    assert(ssid == "a'\"><img src=x onerror=alert(1)>&");
    assert(WiFiManager::htmlEntities("ordinary network") == "ordinary network");
    assert(WiFiManager::htmlEntities("&lt;") == "&amp;lt;");
    assert(WiFiManager::htmlEntities(" a ", true) == "&#160;a&#160;");
    testFetchDiagnostics();
    testDiagnosticReplyBudget();
    std::cout << "all assertions passed\n";
}
