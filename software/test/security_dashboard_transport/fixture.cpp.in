// A minimal storage port with short-write, rename-failure and power-cut states.
static std::map<std::string, std::shared_ptr<std::string>> files;
static size_t writeLimit = SIZE_MAX;
static std::string renameFailure;
static std::string removeFailure;
static bool mountFails = false;
class File {
    std::shared_ptr<std::string> data;
    size_t position = 0;
 public:
    File() = default;
    explicit File(std::shared_ptr<std::string> value) : data(value) {}
    explicit operator bool() const { return data != nullptr; }
    size_t size() const { return data ? data->size() : 0; }
    void close() {}
    void flush() {}
    size_t write(uint8_t value) { return write(&value, 1); }
    size_t write(const uint8_t *buffer, size_t size) {
        if (!data || data->size() >= writeLimit) return 0;
        const size_t count = std::min(size, writeLimit - data->size());
        data->append(reinterpret_cast<const char *>(buffer), count); return count;
    }
    int read() { return data && position < data->size() ? static_cast<uint8_t>((*data)[position++]) : -1; }
    size_t readBytes(char *buffer, size_t size) {
        size_t count = 0;
        for (int ch; count < size && (ch = read()) >= 0;) buffer[count++] = ch;
        return count;
    }
};
struct {
    bool begin(bool format) { assert(!format); return !mountFails; }
    bool exists(const char *path) { return files.count(path); }
    bool remove(const char *path) { return removeFailure != path && files.erase(path); }
    File open(const char *path, const char *mode) {
        if (mode[0] == 'w') files[path] = std::make_shared<std::string>();
        return exists(path) ? File(files[path]) : File();
    }
    bool rename(const char *from, const char *to) {
        if (renameFailure == from || !exists(from) || exists(to)) return false;
        files[to] = files[from]; files.erase(from); return true;
    }
} SPIFFS;
