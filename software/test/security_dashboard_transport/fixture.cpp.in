class String : public std::string {
 public:
    using std::string::string;
    String(const std::string &value) : std::string(value) {}
    bool isEmpty() const { return empty(); }
    bool startsWith(const String &value) const { return rfind(value, 0) == 0; }
    bool endsWith(const String &value) const {
        return size() >= value.size() && compare(size()-value.size(), value.size(), value)==0;
    }
    void remove(size_t position) { erase(position); }
    bool reserve(size_t size) {
        if (allocationFails) return false;
        std::string::reserve(size); return true;
    }
    bool concat(const char *data, size_t size) {
        if (allocationFails) return false;
        append(data, size); return true;
    }
    bool equalsIgnoreCase(String other) const {
        String own = *this;
        for (auto &c : own) c = tolower(c);
        for (auto &c : other) c = tolower(c);
        return own == other;
    }
    void replace(const String &from, const String &to) {
        size_t at = 0;
        while ((at = find(from, at)) != npos) {
            std::string::replace(at, from.size(), to); at += to.size();
        }
    }
    size_t write(uint8_t value) { push_back(value); return 1; }
    size_t write(const uint8_t *data, size_t size) {
        return concat(reinterpret_cast<const char *>(data), size) ? size : 0;
    }
};
class Stream {
 public:
    virtual ~Stream() = default;
    virtual size_t write(uint8_t) = 0;
    virtual size_t write(const uint8_t *, size_t) = 0;
    virtual int read() = 0;
    virtual int peek() = 0;
    virtual int available() = 0;
    virtual void flush() = 0;
    void setWriteError() { writeError = true; }
    void setTimeout(unsigned value) { streamTimeout = value; }
    unsigned streamTimeout = 1000;
    bool writeError = false;
};
class IPAddress {};
struct mbedtls_x509_time { int year, mon, day, hour, min, sec; };
struct mbedtls_x509_crt {
    mbedtls_x509_time valid_from, valid_to;
    mbedtls_x509_crt *next = nullptr;
    int version = 3;
    struct { const uint8_t *p; size_t len; } raw = {reinterpret_cast<const uint8_t *>("synthetic-der"), 13};
};
static mbedtls_x509_crt peerCertificate = {
    {2020, 1, 1, 0, 0, 0}, {2035, 1, 1, 0, 0, 0}, nullptr};
static const mbedtls_x509_crt *peerCertificateResult = &peerCertificate;
class WiFiClient : public Stream {
 public:
    bool open = true, ca = false;
    std::string incoming;
    size_t position = 0;
    virtual int connect(IPAddress, uint16_t) { open = true; return 1; }
    virtual int connect(IPAddress ip, uint16_t port, int32_t) { return connect(ip, port); }
    virtual int connect(const char *, uint16_t) { open = true; return 1; }
    virtual int connect(const char *host, uint16_t port, int32_t) { return connect(host, port); }
    virtual uint8_t connected() { return open; }
    virtual void stop() { open = false; }
    int available() override { return open ? incoming.size() - position : 0; }
    int read() override { uint8_t v; return read(&v, 1) == 1 ? v : -1; }
    virtual int read(uint8_t *buffer, size_t size) {
        const size_t count = std::min(size, static_cast<size_t>(available()));
        memcpy(buffer, incoming.data()+position, count); position += count; return count;
    }
    int peek() override { return available() ? incoming[position] : -1; }
    size_t write(uint8_t v) override { return write(&v, 1); }
    size_t write(const uint8_t *, size_t size) override { return open ? size : 0; }
    void flush() override {}
};
class WiFiClientSecure : public WiFiClient {
 public:
    int connect(IPAddress ip, uint16_t port) override { return WiFiClient::connect(ip, port); }
    int connect(IPAddress ip, uint16_t port, int32_t) override { return connect(ip, port); }
    int connect(const char *host, uint16_t port) override { return WiFiClient::connect(host, port); }
    int connect(const char *host, uint16_t port, int32_t) override { return connect(host, port); }
    const mbedtls_x509_crt *getPeerCertificate() { return peerCertificateResult; }
    void setCACertBundle(const uint8_t *data) { ca = data != nullptr; }
    void setHandshakeTimeout(unsigned value) { assert(value > 0 && value <= 30); }
    int lastError(char *, size_t) { return 0; }
};
