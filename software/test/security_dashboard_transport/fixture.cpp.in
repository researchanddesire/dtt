static uint32_t clockMs = 0;
static time_t utc = 1800000000;
static bool synchronize = true, allocationFails = false;
uint32_t millis() { return clockMs; }
void delay(unsigned milliseconds) { clockMs += milliseconds; }
void vTaskDelay(unsigned milliseconds) { delay(milliseconds); }
time_t fakeTime(time_t *) { return utc; }
void configTime(int, int, const char *, const char *) {
    if (synchronize) utc = 1800000000;
}
