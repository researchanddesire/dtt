struct session_load_ready { std::function<bool()> apply; bool &applied; };
struct session_load_failed {};
struct StateMachine {
    bool accepts = true, changeLivePage = false;
    bool process_event(const session_load_ready &event) {
        if (!accepts) return false;
        if (changeLivePage) session.segmentIdx = 100;
        event.applied = event.apply();
        return true;
    }
    bool process_event(session_load_failed) { ++loadFailures; return true; }
} machine;
static auto *stateMachine = &machine;
#define PAGE_SIZE 100
