#include <cassert>
#include <cstdio>
#include <cstdint>
#include "CertificateDateClient.h"

using namespace firmware;
static time_t currentUtc = 1767225600;  // 2026-01-01 UTC
static time_t testClock() { return currentUtc; }
static unsigned char parsedDer = 1;

static mbedtls_x509_crt validCertificate() {
    return {3, {&parsedDer, 1}, {2024, 1, 1, 0, 0, 0},
            {2030, 1, 1, 0, 0, 0}, nullptr};
}

static int httpConnect(Client &client, int signature) {
    int result = 0;
    switch (signature) {
        case 0: result = client.connect("fixture.invalid", 443); break;
        case 1: result = client.connect("fixture.invalid", 443, 3000); break;
        case 2: result = client.connect(IPAddress{}, 443); break;
        case 3: result = client.connect(IPAddress{}, 443, 3000); break;
        default: assert(false);
    }
    if (result == 1) {
        const uint8_t request[] = {'G', 'E', 'T'};
        assert(client.write(request, sizeof(request)) == sizeof(request));
    }
    return result;
}

#if defined(MBEDTLS_HAVE_TIME_DATE)
// The SDK rejects expired and future chain certificates during the handshake
// and may free the peer chain. The client still requires a plausible clock.
int main() {
    static_assert(SDK_VERIFIES_CERTIFICATE_DATES, "SDK date mode expected");
    auto leaf = validCertificate();
    for (int signature = 0; signature < 4; ++signature) {
        for (int scenario = 0; scenario < 4; ++scenario) {
            CertificateDateClient client(testClock);
            // Freed and retained peer chains are both left to the SDK.
            client.peer = signature % 2 == 0 ? nullptr : &leaf;
            currentUtc = 1767225600;
            if (scenario == 1) currentUtc = MINIMUM_CERTIFICATE_UTC - 1;
            if (scenario == 2) currentUtc = -1;
            if (scenario == 3) client.baseHandshakeSucceeds = false;
            assert(httpConnect(client, signature) == (scenario == 0 ? 1 : 0));
            assert(client.handshakes == 1 && client.peerReads == 0);
            assert(client.writes == (scenario == 0 ? 1u : 0u));
            assert(client.open == (scenario == 0));
            if (scenario > 0) assert(client.stops >= 1);
        }
    }
    CertificateDateClient missingClock(nullptr);
    assert(httpConnect(missingClock, 1) == 0 && missingClock.writes == 0);
    std::puts("SDK certificate date mode assertions passed");
}
#else
int main() {
    static_assert(!SDK_VERIFIES_CERTIFICATE_DATES, "Chain date mode expected");
    auto leaf = validCertificate();
    auto intermediate = validCertificate();
    leaf.next = &intermediate;
    assert(certificateChainDatesValid(&leaf, currentUtc));

    // Every Client-dispatched overload checks all presented certificates before
    // letting the HTTP caller transmit; preserve base CA/hostname rejection.
    for (int signature = 0; signature < 4; ++signature) {
        for (int scenario = 0; scenario < 7; ++scenario) {
            CertificateDateClient client(testClock);
            leaf = validCertificate();
            intermediate = validCertificate();
            leaf.next = &intermediate;
            client.peer = &leaf;
            currentUtc = 1767225600;
            if (scenario == 1) intermediate.valid_to = {2025, 12, 31, 23, 59, 59};
            if (scenario == 2) intermediate.valid_from = {2026, 1, 1, 0, 0, 1};
            if (scenario == 3) client.peer = nullptr;
            if (scenario == 4) intermediate.valid_from.mon = 13;
            if (scenario == 5) currentUtc = -1;
            if (scenario == 6) client.baseHandshakeSucceeds = false;
            assert(httpConnect(client, signature) == (scenario == 0 ? 1 : 0));
            assert(client.handshakes == 1);
            assert(client.writes == (scenario == 0 ? 1u : 0u));
            assert(client.open == (scenario == 0));
            if (scenario > 0) assert(client.stops >= 1);
            if (scenario == 6) assert(client.peerReads == 0);
        }
    }
    currentUtc = 1767225600;
    CertificateDateClient reused(testClock);
    leaf = validCertificate();
    reused.peer = &leaf;
    assert(httpConnect(reused, 1) == 1);
    reused.baseHandshakeSucceeds = false;
    assert(httpConnect(reused, 1) == 0);
    assert(!reused.open && reused.writes == 1);
    CertificateDateClient missingClock(nullptr);
    leaf = validCertificate();
    missingClock.peer = &leaf;
    assert(httpConnect(missingClock, 1) == 0 && missingClock.writes == 0);

    // Inclusive validity endpoints; reject one second outside either endpoint.
    leaf.valid_from = {2026, 1, 1, 0, 0, 0};
    leaf.valid_to = leaf.valid_from;
    assert(certificateChainDatesValid(&leaf, currentUtc));
    assert(!certificateChainDatesValid(&leaf, currentUtc - 1));
    assert(!certificateChainDatesValid(&leaf, currentUtc + 1));
    leaf.valid_from = {2027, 1, 1, 0, 0, 0};
    assert(!certificateChainDatesValid(&leaf, currentUtc));

    const mbedtls_x509_time malformed[] = {
        {0, 1, 1, 0, 0, 0}, {10000, 1, 1, 0, 0, 0},
        {2026, 0, 1, 0, 0, 0}, {2026, 13, 1, 0, 0, 0},
        {2026, 1, 0, 0, 0, 0}, {2026, 1, 32, 0, 0, 0},
        {2026, 4, 31, 0, 0, 0}, {2026, 2, 29, 0, 0, 0},
        {1900, 2, 29, 0, 0, 0}, {2100, 2, 29, 0, 0, 0},
        {2026, 1, 1, -1, 0, 0}, {2026, 1, 1, 24, 0, 0},
        {2026, 1, 1, 0, -1, 0}, {2026, 1, 1, 0, 60, 0},
        {2026, 1, 1, 0, 0, -1}, {2026, 1, 1, 0, 0, 60},
    };
    for (const auto &date : malformed) {
        assert(!certificateCalendarValid(date));
        leaf = validCertificate();
        leaf.valid_from = date;
        assert(!certificateChainDatesValid(&leaf, currentUtc));
        leaf = validCertificate();
        leaf.valid_to = date;
        assert(!certificateChainDatesValid(&leaf, currentUtc));
    }
    assert(certificateCalendarValid({2000, 2, 29, 23, 59, 59}));
    assert(certificateCalendarValid({2024, 2, 29, 0, 0, 0}));
    assert(certificateCalendarValid({1900, 2, 28, 0, 0, 0}));
    leaf = validCertificate();
    assert(certificateChainDatesValid(&leaf, MINIMUM_CERTIFICATE_UTC));
    assert(!certificateChainDatesValid(&leaf, MINIMUM_CERTIFICATE_UTC - 1));
    assert(!certificateChainDatesValid(&leaf, 0));
    assert(!certificateChainDatesValid(&leaf, -1));
    assert(!certificateChainDatesValid(&leaf, static_cast<int32_t>(0x80000000u)));
    leaf.valid_to = {2038, 1, 19, 3, 14, 7};
    assert(certificateChainDatesValid(&leaf, INT32_MAX));
    if (sizeof(time_t) > 4) {
        leaf.valid_to = {2099, 12, 31, 23, 59, 59};
        assert(certificateChainDatesValid(&leaf, MAXIMUM_CERTIFICATE_UTC));
        assert(!certificateChainDatesValid(&leaf, MAXIMUM_CERTIFICATE_UTC + 1));
    }

    for (int scenario = 0; scenario < 4; ++scenario) {
        leaf = validCertificate();
        if (scenario == 0) leaf.version = 0;
        if (scenario == 1) leaf.version = 4;
        if (scenario == 2) leaf.raw.p = nullptr;
        if (scenario == 3) leaf.raw.len = 0;
        assert(!certificateChainDatesValid(&leaf, currentUtc));
    }
    mbedtls_x509_crt chain[MAX_PRESENTED_CERTIFICATES + 1];
    for (size_t i = 0; i < MAX_PRESENTED_CERTIFICATES + 1; ++i) {
        chain[i] = validCertificate();
        if (i > 0) chain[i - 1].next = &chain[i];
    }
    assert(!certificateChainDatesValid(chain, currentUtc));
    chain[MAX_PRESENTED_CERTIFICATES - 1].next = nullptr;
    assert(certificateChainDatesValid(chain, currentUtc));
    chain[1].next = &chain[0];
    assert(!certificateChainDatesValid(chain, currentUtc));
    std::puts("certificate date and connection assertions passed");
}
#endif
